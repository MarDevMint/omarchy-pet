#!/bin/bash

# Pack Clawd's GIFs into assets/clawd/spritesheet.png: one row per move,
# 8 columns of 192x208 cells. Row order must match ROWS in lib/Moves.js.
#
# Each entry is "gif-path|vertical-shift". The shift moves a GIF down so
# every move stands on the same ground line (y=200 in the cell).
#
# Usage: tools/build-atlas            (writes the plugin's spritesheet)
#        tools/build-atlas out.png    (writes somewhere else, for previews)

set -euo pipefail

plugin="$(cd -- "$(dirname -- "$0")/.." && pwd)"
pics="$HOME/Pictures/Claude_pet"
out="${1:-$plugin/assets/clawd/spritesheet.png}"

rows=(
  "$pics/clawd-gifs/clawd-failed.gif|0"                     # 0 rest
  "$pics/clawd-gifs/clawd-idle.gif|0"                       # 1 music
  "$pics/clawd-gifs/clawd-waving.gif|0"                     # 2 build
  "$pics/clawd-gifs/clawd-waiting.gif|0"                    # 3 laptop
  "$pics/clawd-gifs/clawd-review.gif|0"                     # 4 reading
  "$pics/clawd2-svg-gifs/recolored-c97159/clawd-walk-right.gif|16"  # 5 walk right
  "$pics/clawd2-svg-gifs/recolored-c97159/clawd-walk-left.gif|16"   # 6 walk left
)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

strips=()
for i in "${!rows[@]}"; do
  IFS='|' read -r gif shift <<<"${rows[$i]}"
  [[ -f $gif ]] || { echo "missing: $gif" >&2; exit 1; }
  magick "$gif" -coalesce +repage -roll "+0+$shift" "$work/f$i-%02d.png"
  frames=("$work"/f$i-*.png)
  (( ${#frames[@]} <= 8 )) || { echo "too many frames (${#frames[@]}): $gif" >&2; exit 1; }
  magick "${frames[@]}" -background none +append +repage \
    -extent 1536x208 "$work/row$i.png"
  strips+=("$work/row$i.png")
  echo "row $i: ${#frames[@]} frames  $(basename "$gif")"
done

magick "${strips[@]}" -background none -append +repage "$out"
magick identify "$out"
